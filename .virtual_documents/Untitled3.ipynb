import numpy as np
import matplotlib.pyplot as plt

# 1. Δημιουργούμε 1.000 τυχαίους μισθούς με μέσο όρο 1500€ και τυπική απόκλιση 300€
np.random.seed(42)
salaries = np.random.normal(loc=1500, scale=300, size=1000)

# 2. Δημιουργία του Ιστογράμματος
plt.figure(figsize=(8, 5))
# Το bins=20 χωρίζει τα δεδομένα σε 20 "κουτάκια" (μπάρες)
plt.hist(salaries, bins=20, color='crimson', edgecolor='black', alpha=0.7)

# 3. Τίτλοι και Labels
plt.title("Κατανομή Μισθών 1.000 Εργαζομένων", fontsize=14, fontweight='bold')
plt.xlabel("Μισθός (€)", fontsize=12)
plt.ylabel("Πλήθος Εργαζομένων", fontsize=12)

# 4. Εμφάνιση
plt.grid(axis='y', linestyle='--', alpha=0.5) # Grid μόνο στον οριζόντιο άξονα Y
plt.show()


import pandas as pd
import numpy as np
import seaborn as sns
import matplotlib.pyplot as plt

# 1. Ρύθμιση για να έχει το Seaborn ένα όμορφο, μοντέρνο στυλ
sns.set_theme(style="whitegrid")

# 2. Δημιουργούμε ένα DataFrame πωλήσεων
np.random.seed(42)
data = {
    "Κατηγορία": np.random.choice(["Ηλεκτρονικά", "Ένδυση", "Σπίτι"], size=150),
    "Έσοδα (€)": np.random.normal(loc=350, scale=100, size=150).round(2),
    "Πλατφόρμα": np.random.choice(["Website", "App"], size=150)
}
df_sales = pd.DataFrame(data)

# Προσθέτουμε επίτηδες 2 τεράστια Outliers στα Ηλεκτρονικά για το Boxplot μετά!
df_sales.loc[10, "Έσοδα (€)"] = 950.00
df_sales.loc[50, "Έσοδα (€)"] = 880.00

# 3. ΔΙΑΓΡΑΜΜΑ Α: Bar Plot (Μέσος Όρος Εσόδων ανά Κατηγορία)
plt.figure(figsize=(8, 5))
sns.barplot(data=df_sales, x="Κατηγορία", y="Έσοδα (€)", palette="muted", hue="Κατηγορία", legend=False)

plt.title("Μέσος Όρος Εσόδων ανά Κατηγορία Προϊόντων", fontsize=14, fontweight='bold')
plt.show()import pandas as pd
import numpy as np
import seaborn as sns
import matplotlib.pyplot as plt

# 1. Ρύθμιση για να έχει το Seaborn ένα όμορφο, μοντέρνο στυλ
sns.set_theme(style="whitegrid")

# 2. Δημιουργούμε ένα DataFrame πωλήσεων
np.random.seed(42)
data = {
    "Κατηγορία": np.random.choice(["Ηλεκτρονικά", "Ένδυση", "Σπίτι"], size=150),
    "Έσοδα (€)": np.random.normal(loc=350, scale=100, size=150).round(2),
    "Πλατφόρμα": np.random.choice(["Website", "App"], size=150)
}
df_sales = pd.DataFrame(data)

# Προσθέτουμε επίτηδες 2 τεράστια Outliers στα Ηλεκτρονικά για το Boxplot μετά!
df_sales.loc[10, "Έσοδα (€)"] = 950.00
df_sales.loc[50, "Έσοδα (€)"] = 880.00

# 3. ΔΙΑΓΡΑΜΜΑ Α: Bar Plot (Μέσος Όρος Εσόδων ανά Κατηγορία)
plt.figure(figsize=(8, 5))
sns.barplot(data=df_sales, x="Κατηγορία", y="Έσοδα (€)", palette="muted", hue="Κατηγορία", legend=False)

plt.title("Μέσος Όρος Εσόδων ανά Κατηγορία Προϊόντων", fontsize=14, fontweight='bold')
plt.show()


df_sales.head(20)


# ΔΙΑΓΡΑΜΜΑ Β: Box Plot (Κατανομή Εσόδων ανά Κατηγορία ΚΑΙ Πλατφόρμα)
plt.figure(figsize=(9, 6))
sns.boxplot(data=df_sales, x="Κατηγορία", y="Έσοδα (€)", hue="Πλατφόρμα", palette="pastel")

plt.title("Ανίχνευση Outliers και Κατανομή Εσόδων", fontsize=14, fontweight='bold')
plt.xlabel("Κατηγορία Προϊόντος")
plt.ylabel("Έσοδα (€)")
plt.show()



